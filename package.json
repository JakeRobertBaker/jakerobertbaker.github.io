{
  "name": "jake-notes",
  "private": true,
  "type": "module",
  "description": "Markdown mathematics notes built with Astro and Starlight",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "screenshots": "node scripts/screenshots.mjs",
    "test:preview": "node --test tests/preview-tools.test.mjs",
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "check": "astro check && npm run fences",
    "fences": "node scripts/fences.mjs",
    "fences:fix": "node scripts/fences.mjs --fix",
    "validate": "npm run check && npm run test:math && npm run build && npm run test:preview && npm run test:site",
    "test:math": "node --test tests/math-blocks.test.mjs tests/fences.test.mjs",
    "test:site": "playwright test",
    "test:theme": "playwright test theme.spec.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.1",
    "d3-force": "3.0.0",
    "hast-util-to-html": "9.0.5",
    "katex": "0.19.1",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
