{
  "name": "jake-notes",
  "private": true,
  "type": "module",
  "description": "Markdown mathematics notes built with Astro and Starlight",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "screenshots": "node scripts/screenshots.mjs",
    "test:preview": "node --test tests/preview-tools.test.mjs",
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "npm run check && npm run test:math && npm run build && npm run test:preview && npm run test:site",
    "test:math": "node --test tests/math-blocks.test.mjs",
    "test:site": "playwright test",
    "test:theme": "playwright test theme.spec.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.0",
    "katex": "0.19.0",
    "mdast-util-directive": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "$katex",
    "postcss-selector-parser": "7.1.6"
  }
}
